# Optional overrides for docker-compose.yml.
#
# docker-compose.yml already has working defaults baked in for every one
# of these — `docker compose up --build` works from a clean checkout with
# no .env file at all. Copy this file to `.env` only if you want different
# MySQL credentials or a different host port for the frontend.

MYSQL_DATABASE=enfos_reporting
MYSQL_USER=enfos
MYSQL_PASSWORD=enfos
MYSQL_ROOT_PASSWORD=enfos

# Host port the frontend (Nginx) is published on.
FRONTEND_PORT=80

# Allowed CORS origin for the backend (only exercised by `npm run dev`
# workflows that talk to the backend directly; the Docker deployment is
# same-origin through Nginx and doesn't need this).
CORS_ALLOWED_ORIGINS=http://localhost:5173
